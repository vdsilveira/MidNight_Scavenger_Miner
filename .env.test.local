###############################################
# 🔐 SEED PHRASES
###############################################

# Seed principal usada no registro e mineração
SEED_PHRASE="bacon bacon bacon ..."

# Seed opcional para scripts como donate_to
# SEED_PHRASE2="bacon bacon bacon ..."


###############################################
# 🏠 ENDEREÇOS
###############################################

# Endereço principal que recebe mining rights (caso aplicável)
MAIN_ADDRESS="addr1q8zylq27r648tnzn..."


###############################################
# ⚙️ CONFIGURAÇÕES DE MINERAÇÃO
###############################################

# Número de endereços Cardano derivados para mineração
ADDRESS_COUNT=35

# Número máximo de workers paralelos (ideal = núcleos - 2)
MAX_CONCURRENT_WORKERS=30

# Iniciar mineração automaticamente ao rodar o app
AUTO_MINE=true

# Ativa WebAssembly (sempre deixe true)
WASM_ENABLED=true


###############################################
# 📊 MONITORAMENTO E LOGS
###############################################

# Intervalo de logs de estatísticas (ms)
LOG_MINING_STATS_INTERVAL_MS=60000

# Logs detalhados do processo de hash
DEBUG_HASH_LOGS=true


###############################################
# 🧠 MEMÓRIA E OTIMIZAÇÃO
###############################################

# Memória máxima do Node.js (MB)
NODE_OPTIONS="--max-old-space-size=8192"

# Modo produção para otimizações de performance
NODE_ENV="production"

# Otimizações do V8
V8_OPTIMIZATIONS=true

# Execução máxima de cada worker antes de checar novo challenge
MAX_WORKER_RUNTIME=500

# Tamanho do buffer de preimage
PREIMAGE_BUFFER_SIZE=1000

# Intervalo de limpeza de memória (ms)
MEMORY_CLEANUP_INTERVAL=300000


###############################################
# 🔢 NONCE
###############################################

USE_FIXED_NONCE=false
INITIAL_NONCE_HEX="000000e8a1b19c45"


###############################################
# 🌐 REDE
###############################################

NETWORK="mainnet"


###############################################
# 📜 TERMOS & CONDIÇÕES (mensagem fixa v1.0)
###############################################

TANDC_MESSAGE="I agree to abide by the terms and conditions as described in version 1-0 of the Midnight scavenger mining process: 281ba5f69f4b943e3fb8a20390878a232787a04e4be22177f2472b63df01c200"
